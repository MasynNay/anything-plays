# Python environments and caches
.venv/
.build-venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Platform build output
build/
dist/
release/
*.egg-info/

# Platform and editor files
.DS_Store
__MACOSX/
._*
.vscode/
.idea/

# Game content and downloaded native cores
*.gba
*.gb
*.gbc
*.zip
cores/*
!cores/.gitkeep

# Generated PyInstaller specifications are not source files
*.spec

# Local test, debug and coverage outputs
source-snapshots/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
*.log
test-evidence/
release-evidence/
preserved-native-inputs/
frozen-inputs/
release-inputs/
candidate-assets/

# Never version native application packages, wheels or game dumps
*.deb
*.dmg
*.exe
*.msi
*.pkg
*.whl
*.iso
*.gcm
*.gcz
*.ngp
*.ngc
*.nes
*.sfc
*.smc
*.n64
*.z64
*.v64
